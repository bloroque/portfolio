# Google Calendar API keys
# Get these from https://console.cloud.google.com/apis/credentials
REACT_APP_GOOGLE_API_KEY=your-api-key-here
REACT_APP_GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Google Apps Script URLs
# See agendaConnexion/APPS_SCRIPT_SETUP.txt and formContact/APPS_SCRIPT_SETUP.txt
REACT_APP_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-script-id/exec
REACT_APP_CONTACT_SCRIPT_URL=https://script.google.com/macros/s/your-script-id/exec
